# Application
APP_NAME=Vision Pass

# Face recognition and enrollment
FACE_MODEL_NAME=buffalo_l
FACE_DETECTION_CONFIDENCE=0.60
FACE_RECOGNITION_THRESHOLD=0.45
FACE_ENROLLMENT_MIN_QUALITY=0.70
FACE_DUPLICATE_THRESHOLD=0.40

# Access decisions
ACCESS_CONFIDENCE_THRESHOLD=0.65
ACCESS_UNKNOWN_FACE_ACTION=manual_review
ACCESS_OUTSIDE_SHIFT_ACTION=manual_review
ACCESS_HOLIDAY_ACTION=manual_review
ACCESS_SHIFT_GRACE_MINUTES=0

# Attendance behavior
ATTENDANCE_DUPLICATE_COOLDOWN_MINUTES=10
ATTENDANCE_LATE_GRACE_MINUTES=10
ATTENDANCE_AUTO_CHECKOUT_HOURS=12

# Camera polling
CAMERA_FRAME_INTERVAL_SECONDS=3
CAMERA_REQUEST_TIMEOUT_SECONDS=10

# Upload storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5

# Development/demo bootstrap. Keep false in production and use /signup once.
SEED_DEMO_DATA=true
