# Copy this file to .env before starting the production stack.

# Required secrets. Use long, URL-safe random values and never commit .env.
# POSTGRES_PASSWORD is interpolated into DATABASE_URL, so avoid URL delimiters.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Database
POSTGRES_DB=visionpass
POSTGRES_USER=visionpass

# Public deployment URL and port
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Leave empty when the browser should use the frontend's same-origin /api proxy.
VITE_API_BASE_URL=

# Application
APP_NAME=Vision Pass
SEED_DEMO_DATA=false

# Face recognition and enrollment
FACE_MODEL_NAME=buffalo_l
FACE_DETECTION_CONFIDENCE=0.60
FACE_RECOGNITION_THRESHOLD=0.45
FACE_ENROLLMENT_MIN_QUALITY=0.70
FACE_DUPLICATE_THRESHOLD=0.40

# Access policy
ACCESS_CONFIDENCE_THRESHOLD=0.65
ACCESS_UNKNOWN_FACE_ACTION=manual_review
ACCESS_OUTSIDE_SHIFT_ACTION=manual_review
ACCESS_HOLIDAY_ACTION=manual_review
ACCESS_SHIFT_GRACE_MINUTES=0

# Attendance and cameras
ATTENDANCE_DUPLICATE_COOLDOWN_MINUTES=10
ATTENDANCE_LATE_GRACE_MINUTES=10
ATTENDANCE_AUTO_CHECKOUT_HOURS=12
CAMERA_FRAME_INTERVAL_SECONDS=3
CAMERA_REQUEST_TIMEOUT_SECONDS=10
UPLOAD_MAX_IMAGE_MB=5
